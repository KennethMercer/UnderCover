const
  ADDON_COUNT = 3;

function AddonId(I: Integer): String;
begin
  Result := '';
  case I of
    0: Result := 'chatterbox';
    1: Result := 'f5';
    2: Result := 'xtts';
  end;
end;

function AddonCaption(I: Integer): String;
begin
  Result := '';
  case I of
    0: Result := 'Chatterbox · 3.2 GB · the original cadence engine, which Turbo replaced as the default · open licence (MIT).';
    1: Result := 'F5-TTS · 1.5 GB · lighter on graphics memory, slightly flatter speech · personal, non-commercial use only.';
    2: Result := 'XTTS-v2 · 1.9 GB · longer pauses inside a sentence, slower to read · personal, non-commercial use only.';
  end;
end;

