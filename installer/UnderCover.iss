; UnderCover Windows installer (Inno Setup 6, https://jrsoftware.org/isinfo.php).
; Build:  powershell -ExecutionPolicy Bypass -File installer\build.ps1
;         (writes installer\addons.isi from the add-ons registry, then runs ISCC on this file)
; Output: installer\dist\UnderCover-Setup-<version>.exe  (~2 MB; everything heavy is downloaded by setup.ps1)
;
; Per-user install to %LOCALAPPDATA%\UnderCover: no admin prompt, and the app can write its models/cache/output
; next to itself (config.toml paths are relative to the app folder), or in the folders picked on the
; "Where should UnderCover keep your files?" page (phase 4b).

#define AppName "UnderCover"
; the real sizes (generated by build.ps1 from installer\sizes.json): SizeTotalGB, SizeModelsGB, SizePythonGB
#include "sizes.isi"
; The version is written in one place, undercover/VERSION (the app reads it too: core/about.py).
#define VersionHandle FileOpen(AddBackslash(SourcePath) + "..\undercover\VERSION")
#if VersionHandle == 0
  #error undercover\VERSION is missing: it holds the app's version
#endif
#define AppVersion Trim(FileRead(VersionHandle))
#expr FileClose(VersionHandle)
#if AppVersion == ""
  #error undercover\VERSION is empty: it holds the app's version
#endif

[Setup]
#ifdef ReleaseCheck
; the release check's test build (tests\installer_e2e.ps1): its own name and AppId, no uninstaller, no registration
AppId={{3F1A9C52-6B7E-4D21-9A43-5C0E7D2B8F61}
AppName=UnderCover release check (test)
Uninstallable=no
CreateUninstallRegKey=no
#else
AppId={{E6B05D70-0109-4D65-8AEC-89622D0F5C91}
AppName={#AppName}
#endif
AppVersion={#AppVersion}
AppPublisher=UnderCover
DefaultDirName={localappdata}\{#AppName}
; the folder page always shows (a re-run too), with the previous install's folder as its default
DisableDirPage=no
; an existing folder is the normal case for a re-run (a stopped download carries on there): no "install anyway?"
DirExistsWarning=no
UsePreviousAppDir=yes
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=lowest
OutputDir=dist
#ifdef ReleaseCheck
OutputBaseFilename=UnderCover-release-check
#else
OutputBaseFilename=UnderCover-Setup-{#AppVersion}
#endif
Compression=lzma2
SolidCompression=yes
WizardStyle=modern
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0.19041
UninstallDisplayName={#AppName}

[Messages]
StopDownload=Stop downloading? What's downloaded is kept, and clicking Install again carries on from there.
ButtonStopDownload=&Stop
FinishedLabel=UnderCover is installed, with its AI models. Start it from the Start menu: it runs in the background, and you quit it from the icon near the clock or SafeHouse's System room.

[Files]
; App code. __pycache__ and anything personal (models, cache, output, uploads, logs, test, .venv) stay out.
Source: "..\undercover\*"; DestDir: "{app}\undercover"; Flags: recursesubdirs ignoreversion; Excludes: "__pycache__,*.pyc"
; (scripts\, not tools\: an installed app's tools\ holds uv, ffmpeg and Deno)
Source: "..\scripts\check_env.py"; DestDir: "{app}\scripts"; Flags: ignoreversion
; Package pins: add-ons install their packages --no-deps against these (core/addons.py: config.CONSTRAINTS).
Source: "constraints.txt"; DestDir: "{app}\installer"; Flags: ignoreversion
; The user's own config.toml isn't shipped: the defaults are undercover\config.default.toml (in the app code above), and
; setup writes the user's file (the GPU, where the files live). An update keeps it; uninstall leaves it (not ours).
; Setup scripts + the pinned, hashed requirement files (installer/pin_hashes.py).
Source: "setup.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "detect_gpu.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "python.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "installed.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "selftest.py"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "space.ps1"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "sizes.json"; DestDir: "{app}\installer"; Flags: ignoreversion
; every file setup installs, with its SHA-256 (installer/downloads.py): the download page reads it, and setup.ps1
Source: "downloads.tsv"; DestDir: "{app}\installer"; Flags: ignoreversion
Source: "downloads.tsv"; Flags: dontcopy
; the space check runs from the wizard too, before anything is installed (ExtractTemporaryFile)
Source: "space.ps1"; Flags: dontcopy
; the check of the files an earlier run kept (1.0.1), from the wizard's temp folder too
Source: "keptcheck.ps1"; Flags: dontcopy
; what an install being updated already has (1.0.3: an update downloads only what changed), with the Python rule it reads
Source: "installed.ps1"; Flags: dontcopy
Source: "python.ps1"; Flags: dontcopy
Source: "sizes.json"; Flags: dontcopy
Source: "detect_gpu.ps1"; Flags: dontcopy
Source: "requirements\*.txt"; DestDir: "{app}\installer\requirements"; Flags: ignoreversion
; The install guide (installer/GUIDE.md): what to expect, Repair, the optional extras, uninstall
Source: "GUIDE.md"; DestDir: "{app}"; DestName: "READ ME.md"; Flags: ignoreversion
; The licence, the notices (the parts by others and their licences) and the project's README: an AGPL program handed
; on as an installer carries its licence text (1.0.1)
Source: "..\LICENSE"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\NOTICE"; DestDir: "{app}"; Flags: ignoreversion
Source: "..\README.md"; DestDir: "{app}"; Flags: ignoreversion

#ifndef ReleaseCheck
[Icons]
; The "UnderCover" shortcuts (Start menu, desktop) are made by the code below only once setup has worked
; (CreateLaunchers): a failed setup never leaves a shortcut that looks like a working install.
; Repair: the Doctor checks the install against its record and setup fixes only what's wrong (files and settings kept)
Name: "{group}\Repair {#AppName}"; Filename: "powershell.exe"; Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\installer\setup.ps1"" -InstallDir ""{app}"" -Repair -Pause"; WorkingDir: "{app}"
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"

[Tasks]
Name: "desktopicon"; Description: "Create a desktop shortcut"; Flags: unchecked

#endif

[Run]
; setup.ps1 itself runs from the code below (RunSetup), so its exit code is read: "Start UnderCover now" is offered
; only when it worked.
Filename: "{app}\UnderCover.cmd"; Parameters: "--background"; Description: "Start UnderCover now"; Flags: postinstall nowait skipifsilent unchecked runhidden; Check: SetupWorked

[UninstallDelete]
; Downloaded runtime pieces and caches that are re-made when needed. Kept: voices, covers, songs (models, output,
; uploads) and the training projects in cache\training (hours of collected clips), all the user's.
Type: filesandordirs; Name: "{app}\.venv"
Type: filesandordirs; Name: "{app}\tools"
Type: filesandordirs; Name: "{app}\cache\uv"
Type: filesandordirs; Name: "{app}\cache\downloads"
Type: filesandordirs; Name: "{app}\cache\converted"
Type: filesandordirs; Name: "{app}\cache\keyshift"
Type: filesandordirs; Name: "{app}\cache\previews"
Type: filesandordirs; Name: "{app}\cache\stems"
Type: filesandordirs; Name: "{app}\logs"
; Away from home (phase 20): Tailscale's binaries (fetched on first use, fetched again if needed) and this PC's node keys
; (uninstalling ends the private link; the node then shows as offline in the user's Tailscale admin page)
Type: filesandordirs; Name: "{app}\models\tailscale"
Type: filesandordirs; Name: "{app}\cache\tailscale-fetch"
Type: filesandordirs; Name: "{app}\cache\tailscale-state"
Type: files; Name: "{app}\UnderCover.cmd"
; (the launch shortcuts go in [Code] at uninstall, and only those that start THIS install: a same-named shortcut on the
; desktop can belong to another copy of UnderCover)

[Code]
// The optional add-ons (generated from undercover/core/addons.py by build.ps1): ADDON_COUNT, AddonId(i),
// AddonCaption(i), AddonUrl(i).
#include "addons.isi"

var
  DataPage: TInputDirWizardPage;
  AddonPage: TWizardPage;
  AddonBoxes: array of TNewCheckBox;
  LastDefault: String;
  SetupOK: Boolean;      // setup.ps1 exited 0 (RunSetup)
  SetupCode: Integer;    // its exit code
  RetryButton: TNewButton;
  DownloadPage: TDownloadWizardPage;   // everything setup installs, fetched before anything is installed (rc-fix6)
  DownloadIndex, DownloadCount: Integer;
  DownloadDone, DownloadTotal: Int64;
  Progress: Integer;     // the bar's furthest position (0-1000): it never goes back
  Backend: String;       // the graphics card's PyTorch build, detected once by space.ps1
  DetailsLink, FailDetailsLink: TNewStaticText;
  LinkNote: String;      // the last page's word on a shortcut that had to take another name (CreateLaunchers)
  StepGauge: TNewProgressBar;   // under the main bar: the current step's own progress (bytes), or a marquee
  DirParts, FilesNeed, FilesParts: TNewStaticText;   // the size lines: folder page (second line), files page (both)
  SpaceTimer: LongWord;  // the files page: a moment after the folders change, the size lines follow
  KeptMsg: String;       // the uninstaller's last word: the folders it kept, and why
  Installed: String;     // the download list's destinations this install already has, one a line between line breaks (CheckInstalled)

procedure RetryClick(Sender: TObject); forward;
procedure OpenSetupLog(Sender: TObject); forward;
function DirArg(S: String): String; forward;
function GetLibraryDir(Param: String): String; forward;
function GetWorkDir(Param: String): String; forward;
function GetModelsDir(Param: String): String; forward;
function GetAddons(Param: String): String; forward;
function OnDownloadProgress(const Url, FileName: String; const Progress, ProgressMax: Int64): Boolean; forward;

// ---------------------------------------------------------------- disk space (installer\space.ps1)

// space.ps1 from the wizard's temp folder: the real need per drive for these folders, and the drives that won't fit.
// -> Lbl (what goes where, each drive's free space) and Short (a plain sentence per drive that won't fit, or '')
procedure CheckSpace(Lib, Work, Models, Addons: String; var Need, Parts, Short: String);
var
  Lines: TArrayOfString;
  I, Code: Integer;
  OutFile, Params, S: String;
begin
  Need := '';
  Parts := '';
  Short := '';
  ExtractTemporaryFile('space.ps1');
  ExtractTemporaryFile('sizes.json');
  ExtractTemporaryFile('detect_gpu.ps1');
  OutFile := ExpandConstant('{tmp}\space.txt');
  DeleteFile(OutFile);
  if Backend = '' then Backend := 'auto';
  Params := '-NoProfile -ExecutionPolicy Bypass -File "' + ExpandConstant('{tmp}\space.ps1') + '" -Out "' + OutFile +
    '" -InstallDir "' + DirArg(WizardDirValue) + '" -Backend ' + Backend + ' -Addons "' + Addons + '"';
  if Lib <> '' then Params := Params + ' -LibraryDir "' + DirArg(Lib) + '"';
  if Work <> '' then Params := Params + ' -WorkDir "' + DirArg(Work) + '"';
  if Models <> '' then Params := Params + ' -ModelsDir "' + DirArg(Models) + '"';
  Exec('powershell.exe', Params, ExpandConstant('{tmp}'), SW_HIDE, ewWaitUntilTerminated, Code);
  if not LoadStringsFromFile(OutFile, Lines) then Exit;
  for I := 0 to GetArrayLength(Lines) - 1 do begin
    if Pos('backend|', Lines[I]) = 1 then begin
      if Copy(Lines[I], 9, Length(Lines[I])) <> '' then Backend := Copy(Lines[I], 9, Length(Lines[I]));
    end else if Pos('need|', Lines[I]) = 1 then begin
      if Need <> '' then Need := Need + #13#10;
      Need := Need + Copy(Lines[I], 6, Length(Lines[I]));
    end else if Pos('parts|', Lines[I]) = 1 then begin
      S := Copy(Lines[I], 7, Length(Lines[I]));
      StringChangeEx(S, '|', ' ' + #183 + ' ', True);   // "App 9 GB . AI models 10.5 GB . your files 2.5 GB"
      Parts := S;
    end else if Pos('short|', Lines[I]) = 1 then begin
      if Short <> '' then Short := Short + #13#10;
      Short := Short + Copy(Lines[I], 7, Length(Lines[I]));
    end;
  end;
end;

// A message box. The release check's test build (ISCC /DReleaseCheck, tests\installer_e2e.ps1) never shows one: it
// writes the text to its hooks folder and takes the default answer, so a test run can't put a box on anyone's screen.
function Say(Text: String; Typ: TMsgBoxType; Buttons, Default: Integer): Integer;
begin
#ifdef ReleaseCheck
  SaveStringToFile(ExpandConstant('{param:hooks|}\boxes.txt'), Text + #13#10, True);
  Result := Default;
#else
  Result := SuppressibleMsgBox(Text, Typ, Buttons, Default);
#endif
end;

#ifdef ReleaseCheck
// ---------------------------------------------------------------- the release check's hooks (test build only)
// The test build is the real installer under its own name and AppId, with no uninstaller, no shortcuts and no
// registration. Its wizard stays out of the taskbar and Alt+Tab (a tool window, on no screen), and it tells the
// driver its window handles, its page and its download, through files in the folder /HOOKS= names.
function GetWindowLong(hWnd: LongWord; nIndex: Integer): LongInt; external 'GetWindowLongW@user32.dll stdcall';
function SetWindowLong(hWnd: LongWord; nIndex: Integer; dwNewLong: LongInt): LongInt; external 'SetWindowLongW@user32.dll stdcall';
function FindWindowEx(Parent, After: LongWord; ClassName: String; Title: LongWord): LongWord; external 'FindWindowExW@user32.dll stdcall';
function GetWindowThreadProcessId(hWnd: LongWord; var Pid: LongWord): LongWord; external 'GetWindowThreadProcessId@user32.dll stdcall';
function GetCurrentProcessId: LongWord; external 'GetCurrentProcessId@kernel32.dll stdcall';

procedure Hook(Name, Text: String);
begin
  SaveStringToFile(ExpandConstant('{param:hooks|}\') + Name, Text, False);
end;

// a tool window (WS_EX_TOOLWINDOW, not WS_EX_APPWINDOW): no taskbar button, not in Alt+Tab
procedure ToolWindow(H: LongWord);
begin
  if H <> 0 then SetWindowLong(H, -20, (GetWindowLong(H, -20) or $80) and not $40000);
end;

// the wizard, and Inno's fallback window while a program it started runs ("Setup", shown in Alt+Tab otherwise)
procedure HideTestWindows;
var
  H, Pid: LongWord;
begin
  ToolWindow(WizardForm.Handle);
  WizardForm.Left := -6000;
  H := FindWindowEx(0, 0, 'TWindowDisabler-Window', 0);
  while H <> 0 do begin
    Pid := 0;
    GetWindowThreadProcessId(H, Pid);
    if Pid = GetCurrentProcessId then ToolWindow(H);
    H := FindWindowEx(0, H, 'TWindowDisabler-Window', 0);
  end;
end;
#endif

// a drive that won't fit: said plainly; Yes goes on anyway, No stays to pick another folder
function SpaceOK(Short: String): Boolean;
begin
  Result := True;
  if Short <> '' then
    Result := Say(Short + #13#10#13#10 + 'Go on anyway? No lets you pick another folder.',
      mbConfirmation, MB_YESNO or MB_DEFBUTTON2, IDNO) = IDYES;
end;

// the folder page: the real size, per drive, instead of Inno's "at least ... MB" (the installer's own files only)
procedure ShowDirSpace;
var
  Need, Parts, Short: String;
begin
  WizardForm.DiskSpaceLabel.Caption := 'Checking how much space UnderCover needs here...';
  DirParts.Caption := '';
  CheckSpace('', '', '', '', Need, Parts, Short);
  if Need = '' then Need := 'UnderCover needs about {#SizeTotalGB} GB of free space.';   // the check couldn't run: never a stuck "Checking"
  WizardForm.DiskSpaceLabel.Caption := Need;
  DirParts.Caption := Parts;
end;

// the files page: the same two lines, one line per drive when the folders are split
procedure ShowFilesSpace;
var
  Need, Parts, Short: String;
begin
  CheckSpace(DataPage.Values[0], DataPage.Values[1], DataPage.Values[2], '', Need, Parts, Short);
  FilesNeed.Caption := Need;
  FilesParts.Caption := Parts;
end;

function SetTimer(hWnd: LongWord; nIDEvent, uElapse: LongWord; lpTimerFunc: LongWord): LongWord;
  external 'SetTimer@user32.dll stdcall';
function KillTimer(hWnd: LongWord; uIDEvent: LongWord): BOOL;
  external 'KillTimer@user32.dll stdcall';

procedure SpaceTimerFired(H: LongWord; Msg: LongWord; IdEvent: LongWord; Time: LongWord);
begin
  KillTimer(0, SpaceTimer);
  SpaceTimer := 0;
  if WizardForm.CurPageID = DataPage.ID then ShowFilesSpace;
end;

// a folder changed (typed or browsed): the size lines follow a moment later, not on every key
procedure DataEditChange(Sender: TObject);
begin
  if SpaceTimer <> 0 then KillTimer(0, SpaceTimer);
  SpaceTimer := SetTimer(0, 0, 900, CreateCallback(@SpaceTimerFired));
end;

// the wizard closing: no size check left to fire after it
procedure DeinitializeSetup;
begin
  if SpaceTimer <> 0 then KillTimer(0, SpaceTimer);
  SpaceTimer := 0;
end;

// a line of size text: the page's own font, or the smaller grey one for "App 9 GB . AI models ..."
function SizeLine(Parent: TWinControl; Top, Height: Integer; Small: Boolean): TNewStaticText;
begin
  Result := TNewStaticText.Create(WizardForm);
  Result.Parent := Parent;
  Result.AutoSize := False;
  Result.WordWrap := True;
  Result.Left := 0;
  Result.Width := Parent.Width;
  Result.Top := Top;
  Result.Height := Height;
  Result.Caption := '';
  if Small then begin
    Result.Font.Size := Result.Font.Size - 1;
    Result.Font.Color := clGrayText;
  end;
end;

// one add-on's licence, from its own "Read the licence" link (the link's Tag is the add-on's number)
procedure OpenLicence(Sender: TObject);
var
  Code: Integer;
begin
  ShellExec('open', AddonUrl(TNewStaticText(Sender).Tag), '', '', SW_SHOWNORMAL, ewNoWait, Code);
end;

procedure InitializeWizard;
var
  I, Top, Cut: Integer;
  Intro, Link, Desc: TNewStaticText;
  Box: TNewCheckBox;
  Caption, Name, Rest: String;
begin
  DataPage := CreateInputDirPage(wpSelectDir, 'Where should UnderCover keep your files?',
    'UnderCover stays where you installed it. Its growing files can go to a roomier drive, if you like.',
    'Each folder gets its own sub-folders. Leave them as they are to keep everything in the install folder. ' +
    'You can move them later in SafeHouse, Storage.', False, '');
  DataPage.Add('Your library: songs, covers, speech and voices (yours: they can''t be downloaded again)');
  DataPage.Add('Working files: training projects (your collected clips), song stems and caches');
  DataPage.Add('Model files: the AI models UnderCover downloads (they can be downloaded again)');

  AddonPage := CreateCustomPage(DataPage.ID, 'Optional add-ons',
    'Extra parts with their own licence. UnderCover works fully without them.');
  Intro := TNewStaticText.Create(AddonPage);
  Intro.Parent := AddonPage.Surface;
  Intro.WordWrap := True;
  Intro.Width := AddonPage.SurfaceWidth;
  Intro.Caption := 'Ticking an add-on accepts its licence. You can add or remove add-ons later in SafeHouse, Add-ons.';
  Top := Intro.Top + Intro.Height + ScaleY(14);
  SetArrayLength(AddonBoxes, ADDON_COUNT);
  for I := 0 to ADDON_COUNT - 1 do begin
    // "F5-TTS, 1.5 GB, what it adds, who may use it" (middle dots): the name on the checkbox, the rest under it
    Caption := AddonCaption(I);
    Cut := Pos(' ' + #183 + ' ', Caption);   // #183: the middle dot (the .iss stays ASCII)
    if Cut > 0 then begin
      Name := Copy(Caption, 1, Cut - 1);
      Rest := Copy(Caption, Cut + 3, Length(Caption));
    end else begin
      Name := Caption;
      Rest := '';
    end;
    Box := TNewCheckBox.Create(AddonPage);
    Box.Parent := AddonPage.Surface;
    Box.Top := Top;
    Box.Left := 0;
    Box.Width := AddonPage.SurfaceWidth - ScaleX(120);
    Box.Height := ScaleY(17);
    Box.Caption := 'Add ' + Name + ' and accept its licence';
    Box.Checked := False;
    AddonBoxes[I] := Box;
    Desc := TNewStaticText.Create(AddonPage);
    Desc.Parent := AddonPage.Surface;
    Desc.Top := Top + Box.Height + ScaleY(2);
    Desc.Left := ScaleX(18);
    Desc.Width := AddonPage.SurfaceWidth - ScaleX(18);
    Desc.WordWrap := True;
    Desc.Caption := Rest;
    Link := TNewStaticText.Create(AddonPage);
    Link.Parent := AddonPage.Surface;
    Link.Top := Top + ScaleY(2);
    Link.Left := AddonPage.SurfaceWidth - ScaleX(110);
    Link.Caption := 'Read the licence';
    Link.Font.Color := clBlue;
    Link.Font.Style := [fsUnderline];
    Link.Cursor := crHand;
    Link.Tag := I;
    Link.OnClick := @OpenLicence;
    Top := Desc.Top + Desc.Height + ScaleY(14);
  end;

  // the welcome page says the real size, plainly, before anything else
  // (Inno shows no welcome page by default; were it shown, this is the real size. The download, which depends on the
  // graphics card, is on the Ready page: UpdateReadyMemo)
  WizardForm.WelcomeLabel2.Caption := 'UnderCover needs about {#SizeTotalGB} GB of free space in all, far more than this installer.' + #13#10#13#10 +
    'Setup downloads everything it needs first: Python, PyTorch for your graphics card, the tools and the AI models. ' +
    'Nothing downloads later, except add-ons you choose or a repair.';
  WizardForm.DiskSpaceLabel.WordWrap := True;
  WizardForm.DiskSpaceLabel.Top := WizardForm.DirEdit.Top + WizardForm.DirEdit.Height + ScaleY(20);
  WizardForm.DiskSpaceLabel.Height := ScaleY(30);
  DirParts := SizeLine(WizardForm.SelectDirPage, WizardForm.DiskSpaceLabel.Top + WizardForm.DiskSpaceLabel.Height + ScaleY(2), ScaleY(30), True);
  DirParts.Left := WizardForm.DiskSpaceLabel.Left;
  DirParts.Width := WizardForm.DiskSpaceLabel.Width;
  // the files page: under its last folder box, the same lines (one per drive once the folders are split)
  FilesNeed := SizeLine(DataPage.Surface, DataPage.Edits[2].Top + DataPage.Edits[2].Height + ScaleY(14), ScaleY(44), False);
  FilesParts := SizeLine(DataPage.Surface, FilesNeed.Top + FilesNeed.Height + ScaleY(2), ScaleY(18), True);
  DataPage.Edits[0].OnChange := @DataEditChange;
  DataPage.Edits[1].OnChange := @DataEditChange;
  DataPage.Edits[2].OnChange := @DataEditChange;

  // the installing page: under the main bar (the whole install), a bar for the current step
  StepGauge := TNewProgressBar.Create(WizardForm);
  StepGauge.Parent := WizardForm.InstallingPage;
  StepGauge.Left := WizardForm.ProgressGauge.Left;
  StepGauge.Width := WizardForm.ProgressGauge.Width;
  StepGauge.Top := WizardForm.ProgressGauge.Top + WizardForm.ProgressGauge.Height + ScaleY(10);
  StepGauge.Height := WizardForm.ProgressGauge.Height - ScaleY(6);
  StepGauge.Min := 0;
  StepGauge.Max := 1000;
  StepGauge.Visible := False;

  // the setup's raw output, for anyone who wants it (installing page, and the failure page)
  DetailsLink := TNewStaticText.Create(WizardForm);
  DetailsLink.Parent := WizardForm.InstallingPage;
  DetailsLink.Caption := 'Show details';
  DetailsLink.Font.Color := clBlue;
  DetailsLink.Font.Style := [fsUnderline];
  DetailsLink.Cursor := crHand;
  DetailsLink.Top := StepGauge.Top + StepGauge.Height + ScaleY(16);   // below both bars (it once sat on the main one)
  DetailsLink.Left := WizardForm.ProgressGauge.Left;
  DetailsLink.Visible := False;
  DetailsLink.OnClick := @OpenSetupLog;
  DownloadPage := CreateDownloadPage('Downloading what UnderCover needs',
    'Python, PyTorch for your graphics card, the tools and the AI models.', @OnDownloadProgress);
  DownloadPage.ShowBaseNameInsteadOfUrl := True;
#ifdef ReleaseCheck
  HideTestWindows;
  Hook('handles.txt', IntToStr(WizardForm.Handle) + ' ' + IntToStr(WizardForm.NextButton.Handle) + ' ' +
    IntToStr(WizardForm.CancelButton.Handle) + ' ' + IntToStr(DownloadPage.AbortButton.Handle) + ' ' + IntToStr(DetailsLink.Handle));
#endif

  // the last page's "Try again", shown only when setup didn't work
  RetryButton := TNewButton.Create(WizardForm);
  RetryButton.Parent := WizardForm.FinishedPage;
  RetryButton.Caption := 'Try again';
  RetryButton.Width := ScaleX(100);
  RetryButton.Height := ScaleY(24);
  RetryButton.Left := WizardForm.FinishedLabel.Left;
  RetryButton.Top := WizardForm.FinishedLabel.Top + ScaleY(150);
  RetryButton.Visible := False;
  RetryButton.OnClick := @RetryClick;
  FailDetailsLink := TNewStaticText.Create(WizardForm);
  FailDetailsLink.Parent := WizardForm.FinishedPage;
  FailDetailsLink.Caption := 'Show details';
  FailDetailsLink.Font.Color := clBlue;
  FailDetailsLink.Font.Style := [fsUnderline];
  FailDetailsLink.Cursor := crHand;
  FailDetailsLink.Top := RetryButton.Top + ScaleY(4);
  FailDetailsLink.Left := RetryButton.Left + RetryButton.Width + ScaleX(16);
  FailDetailsLink.Visible := False;
  FailDetailsLink.OnClick := @OpenSetupLog;
end;

function SetupWorked: Boolean;
begin
  Result := SetupOK;
end;

// ---------------------------------------------------------------- shortcuts: only ever this install's
// A desktop or Start-menu "UnderCover" may belong to another copy (the user's everyday one): it's never replaced or
// removed. Ours is then "UnderCover (2)", and the uninstaller removes only the shortcuts that start this install.

// a shortcut's target ('' when it can't be read)
function LinkTarget(Path: String): String;
var
  Shell, Lnk: Variant;
begin
  Result := '';
  try
    Shell := CreateOleObject('WScript.Shell');
    Lnk := Shell.CreateShortcut(Path);
    Result := Lnk.TargetPath;
  except
    Result := '';
  end;
end;

// the shortcut exists and starts something in this install's folder
function OurLink(Path: String): Boolean;
begin
  Result := FileExists(Path) and
    (Pos(Lowercase(AddBackslash(ExpandConstant('{app}'))), Lowercase(LinkTarget(Path))) = 1);
end;

// the I-th name a shortcut of ours can have in Folder: "UnderCover", then "UnderCover (2)" .. "(9)"
function LinkPath(Folder: String; I: Integer): String;
begin
  if I = 1 then Result := AddBackslash(Folder) + '{#AppName}.lnk'
  else Result := AddBackslash(Folder) + '{#AppName} (' + IntToStr(I) + ').lnk';
end;

// where ours goes in Folder: the first name that is free or already ours ('' if none is)
function FreeLinkPath(Folder: String): String;
var
  I: Integer;
begin
  Result := '';
  for I := 1 to 9 do
    if (not FileExists(LinkPath(Folder, I))) or OurLink(LinkPath(Folder, I)) then begin
      Result := LinkPath(Folder, I);
      Exit;
    end;
end;

// ours, made in Folder; a note for the last page when it had to take another name
procedure MakeLink(Folder, Where: String);
var
  P: String;
begin
  P := FreeLinkPath(Folder);
  if P = '' then begin
    LinkNote := LinkNote + #13#10#13#10 + 'No shortcut was made ' + Where + ': its UnderCover shortcuts all start other copies.';
    Exit;
  end;
  CreateShellLink(P, '{#AppName}', ExpandConstant('{app}\UnderCover.cmd'), '', ExpandConstant('{app}'), '', 0, SW_SHOWNORMAL);
  if P <> LinkPath(Folder, 1) then
    LinkNote := LinkNote + #13#10#13#10 + 'The shortcut called UnderCover ' + Where + ' starts another copy of ' +
      'UnderCover, so it was left alone, and this one is called ' + ChangeFileExt(ExtractFileName(P), '') + '.';
end;

// The Start-menu (and, if ticked, desktop) shortcut, made once setup has worked
procedure CreateLaunchers;
begin
  LinkNote := '';
#ifndef ReleaseCheck
  MakeLink(ExpandConstant('{group}'), 'in the Start menu');
  if WizardIsTaskSelected('desktopicon') then MakeLink(ExpandConstant('{userdesktop}'), 'on the desktop');
#endif
end;

// at uninstall: the shortcuts that start this install, and no other
procedure RemoveOurLinks(Folder: String);
var
  I: Integer;
begin
  for I := 1 to 9 do
    if OurLink(LinkPath(Folder, I)) then DeleteFile(LinkPath(Folder, I));
end;

// ---------------------------------------------------------------- the uninstaller's last word: what it kept, and why

// a folder from config.toml's [paths] (setup and SafeHouse's Storage write it there), else the default. Both TOML string
// forms: "basic" (escaped backslashes; config set, and Storage since rc-fix5) and 'literal' (as written; Storage before
// rc-fix5, so an install moved then still lists the folders it moved to)
function KeptPath(Key, Fallback: String): String;
var
  Lines: TArrayOfString;
  I, Q: Integer;
  S: String;
begin
  Result := Fallback;
  if not LoadStringsFromFile(ExpandConstant('{app}\config.toml'), Lines) then Exit;
  for I := 0 to GetArrayLength(Lines) - 1 do begin
    S := Trim(Lines[I]);
    if (Pos(Key, S) = 1) and (Pos('=', S) > 0) and (Trim(Copy(S, Length(Key) + 1, Pos('=', S) - Length(Key) - 1)) = '') then begin
      S := Trim(Copy(S, Pos('=', S) + 1, Length(S)));
      if Copy(S, 1, 1) = '"' then begin
        S := Copy(S, 2, Length(S));
        Q := Pos('"', S);
        if Q = 0 then Exit;
        S := Copy(S, 1, Q - 1);
        StringChangeEx(S, '\\', '\', True);   // a basic string's escaped backslashes
      end else if Copy(S, 1, 1) = #39 then begin   // a literal string: as written, no escapes
        S := Copy(S, 2, Length(S));
        Q := Pos(#39, S);
        if Q = 0 then Exit;
        S := Copy(S, 1, Q - 1);
      end else
        Exit;
      StringChangeEx(S, '/', '\', True);
      if (Copy(S, 2, 1) <> ':') and (Copy(S, 1, 2) <> '\\') then S := ExpandConstant('{app}\') + S;   // relative: in the app folder
      Result := S;
      Exit;
    end;
  end;
end;

// the folder holds at least one file or folder
function HasSomething(Dir: String): Boolean;
var
  F: TFindRec;
begin
  Result := False;
  if FindFirst(AddBackslash(Dir) + '*', F) then begin
    try
      repeat
        if (F.Name <> '.') and (F.Name <> '..') then Result := True;
      until Result or not FindNext(F);
    finally
      FindClose(F);
    end;
  end;
end;

function KeptLine(Dir, What: String): String;
begin
  Result := '';
  if HasSomething(Dir) then Result := #13#10 + What + ': ' + Dir;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
var
  Mine, Models: String;
begin
  if CurUninstallStep = usUninstall then begin
    RemoveOurLinks(ExpandConstant('{group}'));
    RemoveOurLinks(ExpandConstant('{userdesktop}'));
    // (read now, while config.toml says where the files went)
    Models := KeptPath('models_dir', ExpandConstant('{app}\models'));
    Mine := KeptLine(KeptPath('uploads_dir', ExpandConstant('{app}\uploads')), 'Your songs') +
      KeptLine(KeptPath('output_dir', ExpandConstant('{app}\output')), 'Your covers and speech') +
      KeptLine(KeptPath('voices_dir', AddBackslash(Models) + 'voices'), 'Your voices') +
      KeptLine(AddBackslash(KeptPath('cache_dir', ExpandConstant('{app}\cache'))) + 'training', 'Your training projects');
    KeptMsg := '';
    if Mine <> '' then
      KeptMsg := 'These folders were kept, because they hold your own work, which can''t be downloaded again:' + #13#10 + Mine;
    if HasSomething(Models) then
      KeptMsg := KeptMsg + #13#10#13#10 + 'The AI models were kept too, so installing again doesn''t fetch them again:' + #13#10 +
        Models;
    if KeptMsg <> '' then KeptMsg := KeptMsg + #13#10#13#10 + 'Delete them yourself if you don''t need them.';
  end;
  if (CurUninstallStep = usPostUninstall) and (KeptMsg <> '') and (not UninstallSilent) then
    MsgBox('UnderCover is removed.' + #13#10#13#10 + KeptMsg, mbInformation, MB_OK);
end;

procedure OpenSetupLog(Sender: TObject);
var
  Code: Integer;
begin
  if FileExists(ExpandConstant('{app}\logs\setup.log')) then
    Exec(ExpandConstant('{win}\notepad.exe'), AddQuotes(ExpandConstant('{app}\logs\setup.log')), '', SW_SHOWNORMAL, ewNoWait, Code);
end;

// the N-th field (from 0) of "a|b|c"
function Field(S: String; N: Integer): String;
var
  I, P: Integer;
begin
  for I := 1 to N do begin
    P := Pos('|', S);
    if P = 0 then begin Result := ''; Exit; end;
    S := Copy(S, P + 1, Length(S));
  end;
  P := Pos('|', S);
  if P > 0 then Result := Copy(S, 1, P - 1) else Result := S;
end;

// one line of setup's output. Its status lines ("@@ step|of|name|per mille|detail") drive the bar and the two lines
// under it; everything else is in setup.log already.
procedure SetupLine(const S: String; const Error, FirstLine: Boolean);
var
  K, N, F, Pos1: Integer;
  Name, Detail, Line, FText: String;
begin
#ifdef ReleaseCheck
  HideTestWindows;
#endif
  if Copy(S, 1, 3) <> '@@ ' then Exit;
  Line := Copy(S, 4, Length(S));
  K := StrToIntDef(Field(Line, 0), 0);
  N := StrToIntDef(Field(Line, 1), 0);
  Name := Field(Line, 2);
  FText := Field(Line, 3);
  F := StrToIntDef(FText, 0);
  Detail := Field(Line, 4);
  if (K < 1) or (N < 1) then Exit;
  Pos1 := ((K - 1) * 1000 + F) div N;
  if Pos1 > Progress then Progress := Pos1;
  if WizardForm.CurPageID = wpFinished then
    WizardForm.FinishedLabel.Caption := Format('Setting it up again, step %d of %d: %s.', [K, N, Name]) + #13#10 + Detail
  else begin
    WizardForm.ProgressGauge.Max := 1000;
    WizardForm.ProgressGauge.Position := Progress;
    WizardForm.StatusLabel.Caption := Format('Step %d of %d: %s', [K, N, Name]);
    WizardForm.FilenameLabel.Caption := Detail;
    StepGauge.Visible := True;
    if FText = '' then
      StepGauge.Style := npbstMarquee   // a step with no byte count: moving, without pretending to know how far
    else begin
      StepGauge.Style := npbstNormal;
      StepGauge.Position := F;
    end;
  end;
end;

// ---------------------------------------------------------------- the downloads (rc-fix6)
// Everything setup installs is in installer\downloads.tsv (installer/downloads.py, at build time). Inno's own download
// page fetches what this PC needs before anything is installed, each file checked against its SHA-256, and puts it in
// place as it arrives: the tools and packages in {app}\cache\downloads, the AI models in the models folder. A file
// already there at its size is skipped, so a stopped or failed download carries on where it stopped. The page answers
// throughout (it pumps messages itself) and has its own Stop button. After it nothing goes online: setup.ps1 runs
// -Offline from these files.

function MoveFileEx(lpExistingFileName, lpNewFileName: String; dwFlags: Cardinal): Integer;
  external 'MoveFileExW@kernel32.dll stdcall';

// the N-th field (from 0) of a tab-separated line
function TabField(S: String; N: Integer): String;
var
  I, P: Integer;
begin
  for I := 1 to N do begin
    P := Pos(#9, S);
    if P = 0 then begin Result := ''; Exit; end;
    S := Copy(S, P + 1, Length(S));
  end;
  P := Pos(#9, S);
  if P > 0 then Result := Copy(S, 1, P - 1) else Result := S;
end;

// where the AI models go: the files page's folder when it's another one, else this install's (config.toml's, when an
// earlier install moved them with SafeHouse's Storage)
function ModelsRoot: String;
begin
  if CompareText(RemoveBackslashUnlessRoot(DataPage.Values[2]), RemoveBackslashUnlessRoot(WizardDirValue)) <> 0 then
    Result := AddBackslash(DataPage.Values[2]) + 'models'
  else
    Result := KeptPath('models_dir', AddBackslash(WizardDirValue) + 'models');
end;

function DownloadDest(Dest: String): String;
begin
  if Pos('cache/', Dest) = 1 then Result := AddBackslash(WizardDirValue) + 'cache\downloads\' + Copy(Dest, 7, Length(Dest))
  else Result := AddBackslash(ModelsRoot) + Copy(Dest, 8, Length(Dest));
  StringChangeEx(Result, '/', '\', True);
end;

// this PC's groups: every install's, the graphics card's PyTorch, the add-ons ticked
function WantedGroup(Group: String): Boolean;
begin
  Result := (Group = 'base') or (Group = 'packages') or (Group = 'models') or (Group = 'torch-' + Backend) or
    ((Pos('addon-', Group) = 1) and (Pos(',' + Copy(Group, 7, Length(Group)) + ',', ',' + GetAddons('') + ',') > 0));
end;

function GBText(N: Int64): String;
var
  E: Extended;
begin
  E := N;
  Result := Format('%.1f', [E / 1000000000.0]);
end;

function DownloadLine(Done: Int64): String;
begin
  Result := Format('File %d of %d: %s of %s GB in all. If it stops, what''s downloaded is kept.', [DownloadIndex,
    DownloadCount, GBText(Done), GBText(DownloadTotal)]);
end;

function OnDownloadProgress(const Url, FileName: String; const Progress, ProgressMax: Int64): Boolean;
begin
  DownloadPage.Description := DownloadLine(DownloadDone + Progress);
  Result := True;
end;

function PSQuote(S: String): String;
begin
  StringChangeEx(S, #39, #39#39, True);
  Result := #39 + S + #39;
end;

// a file name shortened in the middle ("dereverb_mel...ckpt") so Pre + it + Post fits the label's width: the download
// page's line ran past the window with long model names, and "putting everything in its right place" was cut off (1.0.1)
function FitName(Pre, Name, Post: String; L: TNewStaticText): String;
var
  B: TBitmap;
  K: Integer;
begin
  Result := Name;
  B := TBitmap.Create;
  try
    B.Canvas.Font.Assign(L.Font);
    K := Length(Name);
    while (K > 8) and (B.Canvas.TextWidth(Pre + Result + Post) > L.Width) do begin
      K := K - 2;
      Result := Copy(Name, 1, K div 2) + '...' + Copy(Name, Length(Name) - (K - K div 2) + 1, K - K div 2);
    end;
  finally
    B.Free;
  end;
end;

// The downloaded file (in Inno's temp folder) into its place. A small file was checked by Inno itself (its SHA-256)
// and is renamed or copied. A big one (64 MB and up) comes without Inno's check: Inno hashes on its own thread, and a
// gigabyte kept the window from answering for seconds. A hidden PowerShell checks its size and SHA-256 instead, and
// only then moves it into its place, while this page keeps answering. A file that fails is deleted, so nothing uses it,
// and the caller fetches it again. -> '' or what went wrong
function PlaceFile(Src, Dest: String; Bytes: Int64; Sha: String): String;
var
  Part, Marker: String;
  Said: AnsiString;
  Waited: Integer;
  Have: Int64;
  Shell: Variant;
begin
  Result := '';
  ForceDirectories(ExtractFileDir(Dest));
  if Sha = '' then begin
    // MOVEFILE_REPLACE_EXISTING (an earlier copy of the wrong size), MOVEFILE_COPY_ALLOWED, MOVEFILE_WRITE_THROUGH
    if MoveFileEx(Src, Dest, 1 or 2 or 8) = 0 then
      Result := 'it couldn''t be put in ' + ExtractFileDir(Dest) + ' (' + SysErrorMessage(DLLGetLastError) + ')';
  end else begin
    Part := Dest + '.moving';
    Marker := ExpandConstant('{tmp}\moved.txt');
    DeleteFile(Marker);
    DeleteFile(Marker + '.part');
    DeleteFile(Part);
    // (its answer is written whole to moved.txt.part, then named moved.txt: a read never sees half of it). Started
    // through WScript.Shell, not Exec: Inno disables the wizard for as long as its Exec runs, even one that doesn't wait.
    try
      Shell := CreateOleObject('WScript.Shell');
      // (its own module path first: an installer started from PowerShell 7 hands it PowerShell 7's)
      Shell.Run('powershell.exe -NoProfile -NonInteractive -Command "$env:PSModulePath = [Environment]::GetEnvironmentVariable(' +
        '''PSModulePath'', ''Machine''); $m = ' + PSQuote(Marker) + '; $f = ' + PSQuote(Src) +
        '; try { $n = (Get-Item -LiteralPath $f).Length; if ($n -ne ' + IntToStr(Bytes) + ') { throw (''it came to '' + $n + '' of ' +
        IntToStr(Bytes) + ' bytes'') }; if ((Get-FileHash -Algorithm SHA256 -LiteralPath $f).Hash.ToLower() -ne ''' + Sha +
        ''') { throw ''its SHA-256 is wrong'' }; Move-Item -LiteralPath $f -Destination ' + PSQuote(Part) +
        ' -Force -ErrorAction Stop; $s = ''ok'' } catch { $s = $_.Exception.Message; Remove-Item -LiteralPath $f -Force ' +
        '-ErrorAction SilentlyContinue }; Set-Content -LiteralPath ($m + ''.part'') $s; Move-Item -LiteralPath ($m + ''.part'') ' +
        '-Destination $m -Force"', 0, False);   // (0: hidden; False: don't wait)
    except
      Result := 'its check couldn''t start (' + GetExceptionMessage + ')';
      DeleteFile(Src);
      Exit;
    end;
    Waited := 0;
    Said := '';
    while (Trim(String(Said)) = '') and (Waited < 18000) do begin   // (30 minutes: a slow drive, never forever)
      DownloadPage.SetText('Checking ' + FitName('Checking ', ExtractFileName(Dest), ' and putting everything in its right place...',
        DownloadPage.Msg1Label) + ' and putting everything in its right place...', '');
      DownloadPage.SetProgress(DownloadIndex, DownloadCount);   // (keeps the window answering)
      Sleep(100);
      Waited := Waited + 1;
      if FileExists(Marker) then LoadStringFromFile(Marker, Said);
    end;
    if Trim(String(Said)) <> 'ok' then begin
      Result := Trim(String(Said));
      if Result = '' then Result := 'checking it took too long'
      else if (Pos('its SHA-256', Result) <> 1) and (Pos('it came to', Result) <> 1) then
        Result := 'it couldn''t be put in ' + ExtractFileDir(Dest) + ' (' + Result + ')';
      DeleteFile(Src);   // (the PowerShell deletes a file that fails; this covers one that never answered)
      Exit;
    end;
    if MoveFileEx(Part, Dest, 1 or 8) = 0 then
      Result := 'it couldn''t be put in ' + ExtractFileDir(Dest) + ' (' + SysErrorMessage(DLLGetLastError) + ')';
  end;
  if (Result = '') and not (FileSize64(Dest, Have) and (Have = Bytes)) then Result := 'it isn''t the right size after moving';
end;

// what went wrong with a download, in the user's words (rc-polish1: the box said "its SHA-256 is wrong"); the log keeps
// the technical reason. Failed its check, came short, or Inno found its hash wrong: it arrived damaged. Our own reasons
// (a folder it can't be put in) are plain already. Inno's download errors: the connection's, or said as they are
function PlainWhy(Why: String): String;
var
  L: String;
begin
  L := Lowercase(Why);
  if (Pos('sha-256', L) > 0) or (Pos('hash', L) > 0) or (Pos('it came to', L) = 1) or (Pos('the right size', L) > 0) then
    Result := 'it arrived damaged'
  else if (Pos('it couldn''t be put in', L) = 1) or (Pos('checking it took too long', L) = 1) or (Pos('its check couldn''t start', L) = 1) then
    Result := Why
  else if (Pos('http', L) > 0) or (Pos('connect', L) > 0) or (Pos('timed out', L) > 0) or (Pos('timeout', L) > 0) or
      (Pos('server', L) > 0) or (Pos('resolve', L) > 0) or (Pos('no source', L) = 1) then
    Result := 'the connection to its server failed'
  else
    Result := 'it couldn''t be saved (' + Why + ')';   // (a full drive, a file in use: not the connection's)
end;

// one file from its sources (a model's mirrors), in order. -> '' (in Inno's temp folder, checked), 'stopped', or the error
function FetchFile(Urls, Name, Sha: String): String;
var
  P: Integer;
  Url: String;
begin
  Result := 'no source';
  while Urls <> '' do begin
    P := Pos(' ', Urls);
    if P > 0 then begin
      Url := Copy(Urls, 1, P - 1);
      Urls := Copy(Urls, P + 1, Length(Urls));
    end else begin
      Url := Urls;
      Urls := '';
    end;
    DownloadPage.Clear;
    DownloadPage.Add(Url, Name, Sha);
    try
      DownloadPage.Download;
      Result := '';
      Exit;
    except
      if DownloadPage.AbortedByUser then begin
        Result := 'stopped';
        Exit;
      end;
      Result := GetExceptionMessage;
      Log('Download of ' + Url + ' failed: ' + Result);
    end;
  end;
end;

// a downloads.tsv line this PC needs and doesn't have yet (Bytes: its size)
function Pending(Line: String; var Bytes: Int64): Boolean;
var
  Have: Int64;
begin
  Result := False;
  if (Trim(Line) = '') or not WantedGroup(TabField(Line, 0)) then Exit;
  if Pos(#10 + TabField(Line, 1) + #13, Installed) > 0 then Exit;   // installed already, at its pin (an update: 1.0.3)
  Bytes := StrToInt64Def(TabField(Line, 4), 0);
  Result := not (FileSize64(DownloadDest(TabField(Line, 1)), Have) and (Have = Bytes));   // there already: a re-run
end;

// an update (1.0.3: 1.0.2 over 1.0.0 downloaded 108 of 137 files that hadn't changed): installed.ps1, the rule setup.ps1
// uses too, lists what this install already has (a package at its pin in its own .venv, a tool where setup reuses it);
// Pending skips those. Run hidden from the wizard's temp folder, the page answering meanwhile, as CheckKept does.
// Nothing found (a new install, a venv setup didn't make, no answer): nothing skipped.
procedure CheckInstalled;
var
  Waited, N, I: Integer;
  Marker: String;
  Said: AnsiString;
  Shell: Variant;
begin
  Installed := #13#10;
  if not FileExists(ExpandConstant('{app}\.venv\undercover-setup.txt')) and not DirExists(ExpandConstant('{app}\tools')) then Exit;
  Marker := ExpandConstant('{tmp}\installed.txt');
  DeleteFile(Marker);
  DeleteFile(Marker + '.part');
  DownloadPage.SetText('Looking at what this install already has...', '');
  DownloadPage.Show;
  try
    ExtractTemporaryFile('installed.ps1');
    ExtractTemporaryFile('python.ps1');
    Shell := CreateOleObject('WScript.Shell');
    Shell.Run('powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{tmp}\installed.ps1') +
      '" -InstallDir "' + ExpandConstant('{app}') + '" -List "' + ExpandConstant('{tmp}\downloads.tsv') + '" -Out "' + Marker + '"', 0, False);
    Waited := 0;
    while (not FileExists(Marker)) and (Waited < 1800) do begin   // (three minutes: a cold venv's first start, never forever)
      DownloadPage.SetProgress(Waited mod 100, 100);   // (keeps the window answering)
      Sleep(100);
      Waited := Waited + 1;
    end;
    if LoadStringFromFile(Marker, Said) then begin
      Installed := #13#10 + String(Said);
      if Copy(Installed, Length(Installed) - 1, 2) <> #13#10 then Installed := Installed + #13#10;
      N := 0;
      for I := 1 to Length(Installed) do if Installed[I] = #10 then N := N + 1;
      Log(Format('%d files this install already has (installed at their pins): not downloaded again', [N - 1]));
    end else Log('What this install already has couldn''t be read: everything it needs is downloaded');
  except
    Installed := #13#10;
    Log('What this install already has couldn''t be checked: ' + GetExceptionMessage);
  end;
end;

// the graphics card's PyTorch build, read once (space.ps1, from the folder page); none readable: the processor's
procedure EnsureBackend;
var
  Need, Parts, Short: String;
begin
  if (Backend = '') or (Backend = 'auto') then CheckSpace(DataPage.Values[0], DataPage.Values[1], DataPage.Values[2], GetAddons(''), Need, Parts, Short);
  if (Backend = '') or (Backend = 'auto') then Backend := 'cpu';
end;

// what the downloads are for, in plain words
function BackendWords: String;
begin
  if Pos('cuda', Backend) = 1 then Result := 'an NVIDIA graphics card'
  else if Backend = 'rocm' then Result := 'an AMD graphics card'
  else Result := 'the processor (no supported graphics card)';
end;

// the Ready page, just before Install: the download for THIS PC (its graphics card's PyTorch, the add-ons ticked, less
// what's here already), from downloads.tsv, instead of one size for every card (rc-polish1: NVIDIA's is 12.0 GB)
function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo, MemoComponentsInfo, MemoGroupInfo,
  MemoTasksInfo: String): String;
var
  Lines: TArrayOfString;
  I: Integer;
  Bytes, Total: Int64;
begin
  Result := MemoDirInfo;
  if MemoTasksInfo <> '' then Result := Result + NewLine + NewLine + MemoTasksInfo;
  ExtractTemporaryFile('downloads.tsv');
  if not LoadStringsFromFile(ExpandConstant('{tmp}\downloads.tsv'), Lines) then Exit;
  EnsureBackend;
  Total := 0;
  for I := 1 to GetArrayLength(Lines) - 1 do
    if Pending(Lines[I], Bytes) then Total := Total + Bytes;
  Result := Result + NewLine + NewLine + 'Downloads first, before anything is installed:' + NewLine + Space;
  if Total = 0 then
    Result := Result + 'nothing: everything is downloaded already'
  else begin
    Result := Result + 'about ' + GBText(Total) + ' GB: Python, PyTorch for ' + BackendWords + ', the tools and the AI models';
    if GetAddons('') <> '' then Result := Result + ', with the add-ons you ticked';
  end;
end;

// The files an earlier run left, there at their size, checked by their SHA-256 before they're trusted (1.0.1: a kept
// file was skipped by its size alone, and a damaged one stayed until the Doctor's own check). One hidden PowerShell
// for all of them, off Inno's thread as in PlaceFile, the download page answering meanwhile; a file that fails is
// deleted, so the list below fetches it again. Lines: downloads.tsv's.
procedure CheckKept(Lines: TArrayOfString);
var
  I, N, Waited: Integer;
  Dest, ListFile, Marker, DoneFile: String;
  Have: Int64;
  Said, Done: AnsiString;
  Shell: Variant;
begin
  ListFile := ExpandConstant('{tmp}\kept.tsv');
  Marker := ExpandConstant('{tmp}\kept-checked.txt');
  DoneFile := ExpandConstant('{tmp}\kept-done.txt');
  DeleteFile(ListFile);
  DeleteFile(Marker);
  DeleteFile(Marker + '.part');
  DeleteFile(DoneFile);
  N := 0;
  for I := 1 to GetArrayLength(Lines) - 1 do begin
    if (Trim(Lines[I]) = '') or not WantedGroup(TabField(Lines[I], 0)) or (TabField(Lines[I], 3) = '') then Continue;
    Dest := DownloadDest(TabField(Lines[I], 1));
    if FileSize64(Dest, Have) and (Have = StrToInt64Def(TabField(Lines[I], 4), 0)) then begin
      SaveStringToFile(ListFile, Dest + #9 + Lowercase(TabField(Lines[I], 3)) + #13#10, True);
      N := N + 1;
    end;
  end;
  if N = 0 then Exit;
  Log(Format('%d files kept from an earlier run: checking their SHA-256', [N]));
  DownloadPage.Show;
  try
    ExtractTemporaryFile('keptcheck.ps1');
    Shell := CreateOleObject('WScript.Shell');
    Shell.Run('powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "' + ExpandConstant('{tmp}\keptcheck.ps1') +
      '" -List "' + ListFile + '" -Done "' + DoneFile + '" -Marker "' + Marker + '"', 0, False);   // (0: hidden; False: don't wait)
    Waited := 0;
    while (not FileExists(Marker)) and (Waited < 36000) do begin   // (an hour: a slow drive, never forever)
      Done := '';
      if FileExists(DoneFile) then LoadStringFromFile(DoneFile, Done);
      DownloadPage.SetText(Format('Checking the files kept from last time (%d of %d)...', [StrToIntDef(Trim(String(Done)), 0), N]), '');
      DownloadPage.SetProgress(StrToIntDef(Trim(String(Done)), 0), N);   // (keeps the window answering)
      Sleep(100);
      Waited := Waited + 1;
    end;
    if LoadStringFromFile(Marker, Said) then Log('Kept files ' + Trim(String(Said)))
    else Log('The kept files'' check didn''t answer: they''re downloaded again by size as before');
  except
    Log('The kept files couldn''t be checked: ' + GetExceptionMessage);
  end;
end;

// everything this PC needs, from downloads.tsv, before anything is installed. -> True: all here
function DownloadAll: Boolean;
var
  Lines: TArrayOfString;
  Todo: array of Integer;
  I, K: Integer;
  Line, Dest, Name, Why, Short, Urls, InnoSha, CheckSha: String;
  Bytes, Largest, Free, Total: Int64;
  Stopped, Big: Boolean;
  Tries, W: Integer;
#ifdef ReleaseCheck
  BadServed: Boolean;
#endif
begin
  Result := False;
  ExtractTemporaryFile('downloads.tsv');
  if not LoadStringsFromFile(ExpandConstant('{tmp}\downloads.tsv'), Lines) then begin
    Say('The installer''s download list is missing. Download the installer again.', mbError, MB_OK, IDOK);
    Exit;
  end;
  EnsureBackend;
  Log('Downloads for backend ' + Backend + ', add-ons "' + GetAddons('') + '"');
  CheckInstalled;     // (an update: what the install has at its pins isn't downloaded again)
  CheckKept(Lines);   // (a damaged file kept from an earlier run is deleted here, so it's in the list below)
  DownloadTotal := 0;
  Largest := 0;
  SetArrayLength(Todo, 0);
  for I := 1 to GetArrayLength(Lines) - 1 do begin
    if not Pending(Lines[I], Bytes) then Continue;   // not this PC's, or there already (a re-run, a stopped download)
    SetArrayLength(Todo, GetArrayLength(Todo) + 1);
    Todo[GetArrayLength(Todo) - 1] := I;
    DownloadTotal := DownloadTotal + Bytes;
    if Bytes > Largest then Largest := Bytes;
  end;
  DownloadCount := GetArrayLength(Todo);
  Log(Format('%d files to download, %s GB', [DownloadCount, GBText(DownloadTotal)]));
  if DownloadCount = 0 then begin
    Result := True;
    Exit;
  end;
  // Inno's temp folder holds one file at a time, the largest included
  if GetSpaceOnDisk64(ExpandConstant('{tmp}'), Free, Total) and (Free < Largest + 209715200) then begin
    Say('The downloads pass through ' + ExtractFileDrive(ExpandConstant('{tmp}')) + ', which needs ' + GBText(Largest + 209715200) +
      ' GB free for the largest file (it has ' + GBText(Free) + ' GB). Free some space there, then click Install again.', mbError, MB_OK, IDOK);
    Exit;
  end;
  DownloadDone := 0;
  Stopped := False;
#ifdef ReleaseCheck
  BadServed := False;
#endif
  DownloadPage.Show;
  try
    K := 0;
    while (K < DownloadCount) and not Stopped do begin
      DownloadIndex := K + 1;
      Line := Lines[Todo[K]];
      Dest := DownloadDest(TabField(Line, 1));
      Bytes := StrToInt64Def(TabField(Line, 4), 0);
      Name := ExtractFileName(Dest);
      DownloadPage.Description := DownloadLine(DownloadDone);
#ifdef ReleaseCheck
      Hook('download.txt', Format('%d %d', [DownloadIndex, DownloadCount]));
#endif
      // (a big file's SHA-256 is checked by PlaceFile, off Inno's thread; a small one's by Inno as it downloads)
      Big := Bytes >= 67108864;
      if Big then InnoSha := '' else InnoSha := TabField(Line, 3);
      if Big then CheckSha := TabField(Line, 3) else CheckSha := '';
      Tries := 0;
      repeat
        Urls := TabField(Line, 2);
#ifdef ReleaseCheck
        // the release check's proofs: its first file's first try from a server that stops early (a short read), and
        // the first big file's first try from one that sends the right size of the wrong bytes (a bad hash)
        if (K = 0) and (Tries = 0) and (ExpandConstant('{param:shorturl|}') <> '') then
          Urls := ExpandConstant('{param:shorturl|}')
        else if Big and (Tries = 0) and not BadServed and (ExpandConstant('{param:badurl|}') <> '') then begin
          Urls := ExpandConstant('{param:badurl|}') + '?bytes=' + IntToStr(Bytes);
          BadServed := True;
        end;
#endif
        Why := FetchFile(Urls, Name, InnoSha);
        if Why = 'stopped' then begin
          WizardForm.ReadyLabel.Caption := 'The download stopped. What''s downloaded is kept: Install carries on from there.';
          Stopped := True;
        end else if Why = '' then begin
          Why := PlaceFile(ExpandConstant('{tmp}\') + Name, Dest, Bytes, CheckSha);
        end;
        // a server that drops the connection part-way (AMD's did, at 6 of 645 MB, and Inno then found the hash wrong):
        // tried again by itself, three times, before the user is asked
        if (not Stopped) and (Why <> '') then begin
          if Tries < 3 then begin
            Tries := Tries + 1;
            Log(Format('%s: %s; trying again by itself (%d of 3)', [Name, Why, Tries]));
            for W := 1 to Tries * 30 do begin   // 3, 6, 9 s, the page answering throughout
              DownloadPage.SetText(FitName('', Name, ' didn''t come through right. Trying again (3 of 3)...', DownloadPage.Msg1Label) +
                Format(' didn''t come through right. Trying again (%d of 3)...', [Tries]), '');
              DownloadPage.SetProgress(DownloadIndex, DownloadCount);
              Sleep(100);
            end;
          end else begin
            Log(Format('%s: %s; asking the user', [Name, Why]));
            if Say('Couldn''t download ' + Name + ': ' + PlainWhy(Why) + '.' + #13#10#13#10 +
                'What''s downloaded is kept. Try again?', mbError, MB_RETRYCANCEL, IDCANCEL) = IDRETRY then
              Tries := 0   // the user's Try again: three more by itself after this one
            else begin
              WizardForm.ReadyLabel.Caption := 'The download stopped: ' + Name + ': ' + PlainWhy(Why) + '. What''s downloaded is kept: Install carries on from there.';
              Stopped := True;
            end;
          end;
        end;
      until (Why = '') or Stopped;
      if not Stopped then DownloadDone := DownloadDone + Bytes;
      K := K + 1;
    end;
    Result := not Stopped;
  finally
    DownloadPage.Hide;
  end;
end;

// setup.ps1, hidden, from the downloaded files (-Offline: nothing goes online): the wizard's own bar and status lines
// follow it (no console window to close by mistake). Its steps are short (unpacking and installing), so Cancel is off
// while it runs: Inno keeps the wizard still while a program it started runs. A re-run continues past what's done. -> it worked (exit code 0)
// the wizard's own messages, handled while it waits for setup (Pascal Script has no ProcessMessages): clicks, moves,
// minimise, Show details, repaints
type
  TMsg = record
    hwnd: LongWord;
    message: LongWord;
    wParam: LongInt;
    lParam: LongInt;
    time: LongWord;
    ptx: LongInt;
    pty: LongInt;
  end;
function PeekMessage(var Msg: TMsg; hWnd: LongWord; MinMsg, MaxMsg, Remove: LongWord): BOOL; external 'PeekMessageW@user32.dll stdcall';
function TranslateMessage(const Msg: TMsg): BOOL; external 'TranslateMessage@user32.dll stdcall';
function DispatchMessage(const Msg: TMsg): LongInt; external 'DispatchMessageW@user32.dll stdcall';
function OpenProcess(Access: LongWord; Inherit: BOOL; Pid: LongWord): LongWord; external 'OpenProcess@kernel32.dll stdcall';
function WaitForSingleObject(H: LongWord; Ms: LongWord): LongWord; external 'WaitForSingleObject@kernel32.dll stdcall';
function CloseHandle(H: LongWord): BOOL; external 'CloseHandle@kernel32.dll stdcall';

procedure PumpMessages;
var
  Msg: TMsg;
begin
  while PeekMessage(Msg, 0, 0, 0, 1) do begin   // (1: PM_REMOVE)
    TranslateMessage(Msg);
    DispatchMessage(Msg);
  end;
end;

// the process with this id has ended (or can't be found: it's gone)
function ProcessEnded(Pid: LongWord): Boolean;
var
  H: LongWord;
begin
  Result := True;
  if Pid = 0 then Exit;
  H := OpenProcess($00100000, False, Pid);   // (SYNCHRONIZE)
  if H = 0 then Exit;
  Result := WaitForSingleObject(H, 0) = 0;
  CloseHandle(H);
end;

// setup's new status lines (logs\setup-status.txt, after the first Seen) to the bars and the lines under them
procedure FollowStatus(StatusFile: String; var Seen: Integer);
var
  Lines: TArrayOfString;
  I, P: Integer;
begin
  if not LoadStringsFromFile(StatusFile, Lines) then Exit;
  for I := Seen to GetArrayLength(Lines) - 1 do begin
    P := Pos('@@ ', Lines[I]);
    if P > 0 then SetupLine(Copy(Lines[I], P, Length(Lines[I])), False, False);
  end;
  if GetArrayLength(Lines) > Seen then Seen := GetArrayLength(Lines);
end;

// setup.ps1, started through WScript.Shell, hidden and not waited for (rc-fix8, the first NVIDIA install: run by
// ExecAndLogOutput, Inno held the wizard disabled for the whole step: no click, no move, no Show details while PyTorch
// unpacked for minutes; 43 s here, so the release check passed). Its status lines come from logs\setup-status.txt into
// the bars, its output goes to logs\setup-output.txt (copied into this log at the end), and a small PowerShell around it
// writes its exit code to logs\setup-exit.txt when it ends. Cancel stays off (the steps can't be stopped halfway);
// everything else answers. No exit code and the process gone: a failure, said as one.
function RunSetup: Boolean;
var
  Params, Cmd, Logs, ExitFile, PidFile, OutFile, StatusFile: String;
  Said: AnsiString;
  Lines: TArrayOfString;
  Seen, I, Polls: Integer;
  Pid: LongWord;
  Shell: Variant;
begin
  Logs := ExpandConstant('{app}\logs');
  ForceDirectories(Logs);
  ExitFile := Logs + '\setup-exit.txt';
  PidFile := Logs + '\setup-pid.txt';
  OutFile := Logs + '\setup-output.txt';
  StatusFile := Logs + '\setup-status.txt';
  DeleteFile(ExitFile);
  DeleteFile(ExitFile + '.part');
  DeleteFile(PidFile);
  // the log is there from the first moment, so Show details always opens something (rc-fix8: pressed before setup.ps1
  // had written its first line, it did nothing); setup appends to it
  SaveStringToFile(Logs + '\setup.log', GetDateTimeString('yyyy/mm/dd hh:nn:ss', '-', ':') +
    '  Setting up: starting (the steps follow here)' + #13#10, True);
  Seen := 0;
  if LoadStringsFromFile(StatusFile, Lines) then Seen := GetArrayLength(Lines);   // (a Try again: only the new lines)
  // (-NonInteractive: anything that would wait for input fails at once, with its error, instead of hanging unseen.
  // An empty -Addons isn't passed: PowerShell drops an empty argument to a program, and setup's default is none)
  Params := '-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + PSQuote(ExpandConstant('{app}\installer\setup.ps1')) +
    ' -InstallDir ' + PSQuote(ExpandConstant('{app}')) + ' -LibraryDir ' + PSQuote(GetLibraryDir('')) + ' -WorkDir ' +
    PSQuote(GetWorkDir('')) + ' -ModelsDir ' + PSQuote(GetModelsDir('')) + ' -Backend ' + Backend + ' -Offline';
  if GetAddons('') <> '' then Params := Params + ' -Addons ' + PSQuote(GetAddons(''));
  Cmd := 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command "$env:PSModulePath = ' +
    '[Environment]::GetEnvironmentVariable(''PSModulePath'', ''Machine''); Set-Content -LiteralPath ' + PSQuote(PidFile) + ' $PID; ' +
#ifdef ReleaseCheck
    // the release check's proof (rc-fix8): a setup step long enough to see the wizard answer all through it
    'Start-Sleep -Seconds ' + IntToStr(StrToIntDef(ExpandConstant('{param:setuphold|0}'), 0)) + '; ' +
#endif
    // (Out-File as UTF-8: Windows PowerShell's *> writes UTF-16, which this log can't read)
    '& powershell.exe ' + Params + ' *>&1 | Out-File -LiteralPath ' + PSQuote(OutFile) + ' -Encoding utf8; Set-Content -LiteralPath ' + PSQuote(ExitFile + '.part') +
    ' $LASTEXITCODE; Move-Item -LiteralPath ' + PSQuote(ExitFile + '.part') + ' -Destination ' + PSQuote(ExitFile) + ' -Force"';
  Progress := 0;
  WizardForm.ProgressGauge.Max := 1000;
  WizardForm.ProgressGauge.Position := 0;
  WizardForm.StatusLabel.Caption := 'Setting up Python, PyTorch and the tools for your graphics card...';
  WizardForm.FilenameLabel.Caption := 'Everything is downloaded: this part works offline, and it can''t be stopped halfway.';
  DetailsLink.Visible := True;
  WizardForm.CancelButton.Enabled := False;
  SetupCode := -1;
  try
    Shell := CreateOleObject('WScript.Shell');
    Shell.Run(Cmd, 0, False);   // (0: hidden; False: not waited for, so Inno never disables the wizard)
    Pid := 0;
    Polls := 0;
    while not FileExists(ExitFile) do begin
      PumpMessages;
      Sleep(50);
      Polls := Polls + 1;
      if Polls mod 4 = 0 then FollowStatus(StatusFile, Seen);   // (5 times a second)
      if (Pid = 0) and LoadStringFromFile(PidFile, Said) then Pid := StrToIntDef(Trim(String(Said)), 0);
      // gone without its exit code (killed, or PowerShell couldn't start): checked every 2 s, and once more after
      // a last look for the file it may have written just then. No process id after 5 minutes: it never started (a
      // slow first start of PowerShell, an antivirus scan, takes seconds, not minutes)
      if (Polls mod 40 = 0) and ((Pid <> 0) or (Polls > 6000)) and ProcessEnded(Pid) then begin
        Sleep(500);
        if not FileExists(ExitFile) then begin
          Log('Setup''s PowerShell ended without its exit code');
          Break;
        end;
      end;
    end;
    FollowStatus(StatusFile, Seen);
    if LoadStringFromFile(ExitFile, Said) then SetupCode := StrToIntDef(Trim(String(Said)), -1);
    if LoadStringsFromFile(OutFile, Lines) then   // (setup's own output, in this log as before rc-fix8)
      for I := 0 to GetArrayLength(Lines) - 1 do Log('setup: ' + Lines[I]);
  except
    Log('Setup couldn''t start: ' + GetExceptionMessage);
    SetupCode := -1;
  end;
  SetupOK := (SetupCode = 0);
  if SetupOK then CreateLaunchers;
  Result := SetupOK;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then RunSetup;
end;

// what stopped, in setup's own words (logs\setup-result.txt: "failed: <what>"), else its exit code
function FailureText: String;
var
  S: AnsiString;
begin
  Result := Format('setup stopped (exit code %d)', [SetupCode]);
  if LoadStringFromFile(ExpandConstant('{app}\logs\setup-result.txt'), S) then begin
    if Pos('failed: ', String(S)) = 1 then Result := Trim(Copy(String(S), 9, Length(S)));
    if Pos('cancelled: ', String(S)) = 1 then Result := 'you stopped it (' + Trim(Copy(String(S), 12, Length(S))) + ')';
  end;
end;

// the last page: "installed" only when setup worked; else what stopped, where the log is, and Try again
procedure ShowOutcome;
begin
  if SetupOK then begin
    WizardForm.FinishedHeadingLabel.Caption := 'UnderCover is installed';
    WizardForm.FinishedLabel.Caption := SetupMessage(msgFinishedLabel) + LinkNote;
    RetryButton.Visible := False;
  end else begin
    WizardForm.FinishedHeadingLabel.Caption := 'UnderCover isn''t ready yet';
    WizardForm.FinishedLabel.Caption := 'Setting it up stopped: ' + FailureText + '.' + #13#10#13#10 +
      'The details are in ' + ExpandConstant('{app}\logs\setup.log') + '.' + #13#10#13#10 +
      'Try again continues where it stopped. You can also close this and run the installer again later.';
    RetryButton.Visible := True;
  end;
  FailDetailsLink.Visible := RetryButton.Visible;
end;

procedure RetryClick(Sender: TObject);
begin
  RetryButton.Enabled := False;
  WizardForm.FinishedLabel.Caption := 'Setting it up again...';
  WizardForm.NextButton.Enabled := False;
  RunSetup;
  ShowOutcome;
  WizardForm.NextButton.Enabled := True;
  RetryButton.Enabled := True;
end;

procedure CurPageChanged(CurPageID: Integer);
var
  I: Integer;
begin
#ifdef ReleaseCheck
  HideTestWindows;
  if CurPageID = wpReady then Hook('ready.txt', WizardForm.ReadyMemo.Text);   // (the download said for this PC: rc-polish1)
  Hook('page.txt', IntToStr(CurPageID));
#endif
  if CurPageID = wpFinished then ShowOutcome;
  if CurPageID = wpSelectDir then ShowDirSpace;
  // the folders default to the install folder; follow it if it changes, unless the user typed something else
  if CurPageID = DataPage.ID then begin
    for I := 0 to 2 do
      if (DataPage.Values[I] = '') or (DataPage.Values[I] = LastDefault) then
        DataPage.Values[I] := WizardDirValue;
    LastDefault := WizardDirValue;
    if SpaceTimer <> 0 then KillTimer(0, SpaceTimer);
    SpaceTimer := 0;
    ShowFilesSpace;
  end;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Need, Parts, Short: String;
begin
  Result := True;
  if CurPageID = wpSelectDir then begin
    CheckSpace('', '', '', '', Need, Parts, Short);
    Result := SpaceOK(Short);
  end else if CurPageID = DataPage.ID then begin
    CheckSpace(DataPage.Values[0], DataPage.Values[1], DataPage.Values[2], '', Need, Parts, Short);
    Result := SpaceOK(Short);
  end else if (CurPageID = AddonPage.ID) and (GetAddons('') <> '') then begin
    CheckSpace(DataPage.Values[0], DataPage.Values[1], DataPage.Values[2], GetAddons(''), Need, Parts, Short);
    Result := SpaceOK(Short);
  end else if CurPageID = wpReady then
    Result := DownloadAll;   // Install: everything is downloaded first; stopped or failed, the wizard stays here
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := (PageID = AddonPage.ID) and (ADDON_COUNT = 0);
end;


// "E:\" would end the quoted argument with \", which escapes the quote: pass "E:\." instead
function DirArg(S: String): String;
begin
  Result := S;
  if (Length(Result) > 0) and (Result[Length(Result)] = '\') then Result := Result + '.';
end;

function GetLibraryDir(Param: String): String; begin Result := DirArg(DataPage.Values[0]); end;
function GetWorkDir(Param: String): String; begin Result := DirArg(DataPage.Values[1]); end;
function GetModelsDir(Param: String): String; begin Result := DirArg(DataPage.Values[2]); end;

function GetAddons(Param: String): String;
var
  I: Integer;
begin
  Result := '';
  for I := 0 to ADDON_COUNT - 1 do
    if AddonBoxes[I].Checked then begin   // ticked = added, its licence accepted (one checkbox, user 2026-10-18)
      if Result <> '' then Result := Result + ',';
      Result := Result + AddonId(I);
    end;
end;
